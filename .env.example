# =====================================================================
# Nomad Club : variables d'environnement
# Copiez ce fichier en « .env.local » (en local) ou saisissez ces valeurs
# dans Vercel (Settings > Environment Variables). Ne partagez jamais les clés secrètes.
#
# Sans aucune variable, l'appli tourne en MODE DÉMO : données d'exemple en mémoire,
# sélecteur d'espace en haut, paiements simulés. Rien n'est envoyé nulle part.
# =====================================================================

# --- Supabase (base de données + connexion par e-mail) -----------------
# Les deux premières activent le MODE RÉEL.
# Supabase > Project Settings > API : « Project URL » et clé « anon public ».
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » (secrète, côté serveur seulement). Nécessaire pour Stripe
# (enregistrer la session de paiement et confirmer le paiement depuis le webhook).
SUPABASE_SERVICE_ROLE_KEY=

# --- Rappels J-1 (Lot 1) ----------------------------------------------
# Secret du cron quotidien /api/cron/rappels (vercel.json, 17 h UTC). Vercel l'envoie
# dans « Authorization: Bearer … ». En mode réel, nécessite aussi SUPABASE_SERVICE_ROLE_KEY.
CRON_SECRET=

# --- Stripe (paiement par carte) --------------------------------------
# Commencez avec les clés de TEST (sk_test_…). Sans clé Stripe en mode réel,
# le paiement se fait par virement déclaré, validé ensuite par Julia et Nora.
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) : Stripe > Développeurs > Webhooks, adresse
# https://VOTRE-SITE/api/stripe/webhook, événements checkout.session.completed et checkout.session.expired.
STRIPE_WEBHOOK_SECRET=

# --- Site --------------------------------------------------------------
# Adresse publique du site (liens du billet, retour de paiement, lien magique).
# En local : http://localhost:3000. Sur Vercel : https://votre-domaine.
NEXT_PUBLIC_SITE_URL=

# --- Virement (mode réel sans Stripe) -----------------------------------
# Coordonnées affichées quand on règle par virement.
NEXT_PUBLIC_TRANSFER_HOLDER=Nomad Club
NEXT_PUBLIC_TRANSFER_IBAN=

# --- Sécurité (Lot 6) ----------------------------------------------------
# Double authentification (TOTP) exigée pour l'espace fondatrices en mode réel.
# Activer d'abord « Authentication > Multi-Factor » (TOTP) dans Supabase.
# Mettre false seulement pour dépanner (ex. téléphone perdu, le temps de réinitialiser le facteur).
ADMIN_MFA_REQUIRED=true
# Notifications push Web : générer une paire avec « node scripts/vapid-keys.mjs ».
# Sans ces clés, aucun push n'est envoyé et le bouton d'activation est masqué.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@votre-domaine.ma
# Tâche planifiée quotidienne /api/cron/securite (Vercel Cron envoie « Authorization: Bearer CRON_SECRET »).
# Au moins 16 caractères aléatoires (ex. « openssl rand -hex 32 »).
CRON_SECRET=
# Limitation de fréquence : compteurs en base (mode réel + clé service) ou en mémoire.
# RATE_LIMIT_STORE=memory force la mémoire ; RATE_LIMIT_DISABLED=1 coupe tout (tests de charge uniquement).
# RATE_LIMIT_STORE=
# RATE_LIMIT_DISABLED=
# Politique de sécurité du contenu : origines supplémentaires (séparées par des espaces) si un lot ajoute un service.
# CSP_EXTRA_CONNECT=
# CSP_EXTRA_IMG=
# CSP_EXTRA_SCRIPT=
# CSP_EXTRA_FRAME=

# --- Sauvegardes (scripts/backup.sh, à lancer hors de Vercel) -------------
# Chaîne de connexion Postgres (Supabase > Project Settings > Database > Connection string, mode « Session »).
# SUPABASE_DB_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Phrase de chiffrement des sauvegardes (gardée hors du serveur, dans un gestionnaire de mots de passe).
# BACKUP_PASSPHRASE=
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30

# --- Lancement (vague 2, docs/lancement/checklist.md) ----------------------
# false en production : interdit le mode démo (sélecteur, données d'exemple). Sans Supabase, l'appli
# affiche alors « Configuration manquante » au lieu de basculer en démo. Absent : démo permise (développement).
NEXT_PUBLIC_DEMO=
# true : page de maintenance partout (503), sauf /statut, /api/statut et les tâches planifiées. Redéployer après changement.
MAINTENANCE_MODE=false
# Surveillance des erreurs (facultatif) : DSN d'un projet Sentry (https://clé@o000.ingest.sentry.io/0000).
# Aucune donnée personnelle n'est envoyée (ni cookies, ni en-têtes, ni corps ; e-mails et numéros masqués).
SENTRY_DSN=
# Vérifier toutes les variables : npm run check:env -- --production

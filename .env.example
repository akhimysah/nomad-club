# =====================================================================
# Nomad Club : variables d'environnement
# Copiez ce fichier en « .env.local » (en local) ou saisissez ces valeurs
# dans Vercel (Settings > Environment Variables). Ne partagez jamais les clés secrètes.
#
# Sans aucune variable, l'appli tourne en MODE DÉMO : données d'exemple en mémoire,
# sélecteur d'espace en haut, paiements simulés. Rien n'est envoyé nulle part.
# =====================================================================

# --- Supabase (base de données + connexion par e-mail) -----------------
# Les deux premières activent le MODE RÉEL.
# Supabase > Project Settings > API : « Project URL » et clé « anon public ».
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » (secrète, côté serveur seulement). Nécessaire pour Stripe
# (enregistrer la session de paiement et confirmer le paiement depuis le webhook).
SUPABASE_SERVICE_ROLE_KEY=

# --- Rappels J-1 (Lot 1) ----------------------------------------------
# Secret du cron quotidien /api/cron/rappels (vercel.json, 17 h UTC). Vercel l'envoie
# dans « Authorization: Bearer … ». En mode réel, nécessite aussi SUPABASE_SERVICE_ROLE_KEY.
CRON_SECRET=

# --- Paiements (vague 2 · chantier 2a, voir README § 3.2) ---------------
# Prestataire : stripe | transfer (virement déclaré) | simulated (DÉMO UNIQUEMENT, refusé en mode réel).
# Vide : Stripe si STRIPE_SECRET_KEY est définie, sinon virement (réel) ou simulé (démo).
PAYMENT_PROVIDER=
# Devise (code ISO 4217) affichée partout et envoyée à Stripe : USD (défaut), EUR, MAD…
# Changer de devise ne convertit pas les montants : ils sont exprimés dans cette devise.
NEXT_PUBLIC_CURRENCY=USD
# Tarifs annuels (défaut 670 / 1 250 ; passage Premium = différence si vide).
NEXT_PUBLIC_PRICE_MEMBER=670
NEXT_PUBLIC_PRICE_PREMIUM=1250
NEXT_PUBLIC_PRICE_UPGRADE=
# Nombres d'échéances proposés pour l'adhésion (paiement mensuel par carte).
MEMBERSHIP_INSTALLMENTS=1,3,12
# Jours d'impayé tolérés avant de suspendre l'accès membre (rétabli dès le paiement).
MEMBERSHIP_GRACE_DAYS=15
# Relance d'une échéance en retard tous les N jours (notification + e-mail payment_failed).
PAYMENT_REMINDER_EVERY_DAYS=3
# Rappels avant la fin de l'adhésion (jours). PAYMENT_RENEWAL_REMINDERS=false les laisse au cron des e-mails.
RENEWAL_REMINDER_DAYS=30,7,1
# PAYMENT_RENEWAL_REMINDERS=
# Émetteur imprimé sur les reçus PDF générés (quand Stripe n'a pas de facture) : raison sociale, adresse, n° d'entreprise.
PAYMENT_RECEIPT_ISSUER=
# Tâche quotidienne /api/cron/paiements (vercel.json) : même CRON_SECRET que les autres tâches.

# --- Stripe (paiement par carte) --------------------------------------
# Commencez avec les clés de TEST (sk_test_…) ; passage en live = clé sk_live_… (ou rk_live_…), rien d'autre à changer.
# Sans clé Stripe en mode réel, le paiement se fait par virement déclaré, validé ensuite par Julia et Nora.
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) : Stripe > Développeurs > Webhooks, adresse https://VOTRE-SITE/api/stripe/webhook,
# événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired,
# invoice.paid, invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted, charge.refunded.
STRIPE_WEBHOOK_SECRET=
# Prix Stripe facultatifs des formules pro (sinon créés à la volée avec les montants de l'appli).
STRIPE_PRICE_PRO_ESSENTIEL=
STRIPE_PRICE_PRO_VISIBILITE=
STRIPE_PRICE_PRO_VITRINE=
# true : Stripe émet aussi une facture pour les paiements uniques (billets, boutique, adhésion comptant). Payant chez Stripe.
STRIPE_INVOICE_ONE_TIME=false

# --- Site --------------------------------------------------------------
# Adresse publique du site (liens du billet, retour de paiement, lien magique).
# En local : http://localhost:3000. Sur Vercel : https://votre-domaine.
NEXT_PUBLIC_SITE_URL=

# --- Virement (mode réel sans Stripe) -----------------------------------
# Coordonnées affichées quand on règle par virement.
NEXT_PUBLIC_TRANSFER_HOLDER=Nomad Club
NEXT_PUBLIC_TRANSFER_IBAN=

# --- Sécurité (Lot 6) ----------------------------------------------------
# Double authentification (TOTP) exigée pour l'espace fondatrices en mode réel.
# Activer d'abord « Authentication > Multi-Factor » (TOTP) dans Supabase.
# Mettre false seulement pour dépanner (ex. téléphone perdu, le temps de réinitialiser le facteur).
ADMIN_MFA_REQUIRED=true
# Notifications push Web : générer une paire avec « node scripts/vapid-keys.mjs ».
# Sans ces clés, aucun push n'est envoyé et le bouton d'activation est masqué.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@votre-domaine.ma
# Tâche planifiée quotidienne /api/cron/securite (Vercel Cron envoie « Authorization: Bearer CRON_SECRET »).
# Au moins 16 caractères aléatoires (ex. « openssl rand -hex 32 »).
CRON_SECRET=
# Limitation de fréquence : compteurs en base (mode réel + clé service) ou en mémoire.
# RATE_LIMIT_STORE=memory force la mémoire ; RATE_LIMIT_DISABLED=1 coupe tout (tests de charge uniquement).
# RATE_LIMIT_STORE=
# RATE_LIMIT_DISABLED=
# Politique de sécurité du contenu : origines supplémentaires (séparées par des espaces) si un lot ajoute un service.
# CSP_EXTRA_CONNECT=
# CSP_EXTRA_IMG=
# CSP_EXTRA_SCRIPT=
# CSP_EXTRA_FRAME=

# --- E-mails transactionnels (vague 2, docs/emails.md) ---------------------
# Clé API Resend (« re_… », droit Sending access). Sans clé : aucun envoi réel, journal seulement.
RESEND_API_KEY=
# Expéditeur : domaine vérifié chez Resend (SPF, DKIM, DMARC).
EMAIL_FROM="Nomad Club <bonjour@[DOMAINE]>"
# Adresse qui reçoit les réponses (ex. la boîte de Julia et Nora).
EMAIL_REPLY_TO=
# Signature des liens de désinscription (« openssl rand -hex 32 ») ; à défaut CRON_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=
# Force le fournisseur : resend | console | smtp (SMTP prévu, voir src/lib/modules/emails/mailers/smtp.ts).
# EMAIL_PROVIDER=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# --- Sauvegardes (scripts/backup.sh, à lancer hors de Vercel) -------------
# Chaîne de connexion Postgres (Supabase > Project Settings > Database > Connection string, mode « Session »).
# SUPABASE_DB_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Phrase de chiffrement des sauvegardes (gardée hors du serveur, dans un gestionnaire de mots de passe).
# BACKUP_PASSPHRASE=
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30

# --- Lancement (vague 2, docs/lancement/checklist.md) ----------------------
# false en production : interdit le mode démo (sélecteur, données d'exemple). Sans Supabase, l'appli
# affiche alors « Configuration manquante » au lieu de basculer en démo. Absent : démo permise (développement).
NEXT_PUBLIC_DEMO=
# true : page de maintenance partout (503), sauf /statut, /api/statut et les tâches planifiées. Redéployer après changement.
MAINTENANCE_MODE=false
# Surveillance des erreurs (facultatif) : DSN d'un projet Sentry (https://clé@o000.ingest.sentry.io/0000).
# Aucune donnée personnelle n'est envoyée (ni cookies, ni en-têtes, ni corps ; e-mails et numéros masqués).
SENTRY_DSN=
# Vérifier toutes les variables : npm run check:env -- --production

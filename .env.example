# =====================================================================
# Nomad Club : variables d'environnement
# Copiez ce fichier en « .env.local » (en local) ou saisissez ces valeurs
# dans Vercel (Settings > Environment Variables). Ne partagez jamais les clés secrètes.
#
# Sans aucune variable, l'appli tourne en MODE DÉMO : données d'exemple en mémoire,
# sélecteur d'espace en haut, paiements simulés. Rien n'est envoyé nulle part.
# =====================================================================

# --- Supabase (base de données + connexion par e-mail) -----------------
# Les deux premières activent le MODE RÉEL.
# Supabase > Project Settings > API : « Project URL » et clé « anon public ».
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » (secrète, côté serveur seulement). Nécessaire pour Stripe
# (enregistrer la session de paiement et confirmer le paiement depuis le webhook).
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (paiement par carte) --------------------------------------
# Commencez avec les clés de TEST (sk_test_…). Sans clé Stripe en mode réel,
# le paiement se fait par virement déclaré, validé ensuite par Julia et Nora.
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) : Stripe > Développeurs > Webhooks, adresse
# https://VOTRE-SITE/api/stripe/webhook, événements checkout.session.completed et checkout.session.expired.
STRIPE_WEBHOOK_SECRET=

# --- Site --------------------------------------------------------------
# Adresse publique du site (liens du billet, retour de paiement, lien magique).
# En local : http://localhost:3000. Sur Vercel : https://votre-domaine.
NEXT_PUBLIC_SITE_URL=

# --- Virement (mode réel sans Stripe) -----------------------------------
# Coordonnées affichées quand on règle par virement.
NEXT_PUBLIC_TRANSFER_HOLDER=Nomad Club
NEXT_PUBLIC_TRANSFER_IBAN=
